includes:
    - %currentWorkingDirectory%/tests/PHPStan/phpstan.neon

parameters:
    # Dedicated cache for each version
    tmpDir: %currentWorkingDirectory%/var/phpstan-tmp/9.0.x
    ignoreErrors:
        # Add version-specific ignores here as needed
        -
            message: "#Class .*Discount.* not found.#"
            identifier: class.notFound
            count: 20
            path: ../../src/ApiPlatform/Resources/Discount/*
        # The TaxRule create/delete CQRS domain layer only exists since PrestaShop 9.2 (develop).
        # These operations are gated behind experimentalOperation + a runtime class_exists() guard,
        # so they're expected to be absent on 9.0.3.
        -
            message: "#Class .*TaxRulesGroup\\\\TaxRule\\\\(Command|Exception).* not found.#"
            identifier: class.notFound
            count: 6
            path: ../../src/ApiPlatform/Resources/TaxRule/*
        # The carrier queries used by the endpoints declaring minVersion 9.2.0: they are filtered out
        # of the API on this core version, where the classes are indeed absent.
        -
            message: "#Class .*GetAvailableCarriers not found.#"
            identifier: class.notFound
            path: ../../src/ApiPlatform/Resources/Carrier/*
        -
            message: "#Class .*GetCarriersForProduct not found.#"
            identifier: class.notFound
            path: ../../src/ApiPlatform/Resources/Product/ProductCarrier.php
        # The extra property definition CQRS layer (Core\Domain\ExtraProperty, Core\ExtraProperty,
        # ExtraPropertyDefinitionFilters) only exists since PrestaShop 9.2; the operations declare
        # minVersion 9.2.0 so they are filtered out of the API on this core version.
        -
            message: "#Class .*ExtraProperty.* not found.#"
            identifier: class.notFound
            path: ../../src/ApiPlatform/Resources/ExtraPropertyDefinition/*
        # SearchProductsForFreeGift only exists since PrestaShop 9.2, the operation is gated
        # with the minVersion extra property so it is expected to be absent on 9.0.3.
        -
            message: "#Class .*Product\\\\Query\\\\SearchProductsForFreeGift not found.#"
            identifier: class.notFound
            count: 1
            path: ../../src/ApiPlatform/Resources/Product/*
        # GetVirtualProductFileForEditing only exists since PrestaShop 9.3, the get and update operations
        # declare minVersion 9.3.0 so they are filtered out of the API on this core version.
        -
            message: "#Class .*VirtualProductFile\\\\Query\\\\GetVirtualProductFileForEditing not found.#"
            identifier: class.notFound
            path: ../../src/ApiPlatform/Resources/Product/VirtualProductFile.php
