includes:
    - %currentWorkingDirectory%/tests/PHPStan/phpstan.neon

parameters:
    tmpDir: %currentWorkingDirectory%/var/phpstan-tmp/9.1.5
    ignoreErrors:
        # Add version-specific ignores here as needed
        # The TaxRule create/delete CQRS domain layer only exists since PrestaShop 9.2 (develop).
        # These operations are gated behind experimentalOperation + a runtime class_exists() guard,
        # so they're expected to be absent on 9.1.x.
        -
            message: "#Class .*TaxRulesGroup\\\\TaxRule\\\\(Command|Exception).* not found.#"
            identifier: class.notFound
            count: 6
            path: ../../src/ApiPlatform/Resources/TaxRule/*
        # GetCarriersForProduct only exists since PrestaShop 9.2, and the operations using it declare
        # minVersion 9.2.0 so they are filtered out of the API on this core version.
        -
            message: "#Class .*GetCarriersForProduct not found.#"
            identifier: class.notFound
            path: ../../src/ApiPlatform/Resources/Product/ProductCarrier.php
